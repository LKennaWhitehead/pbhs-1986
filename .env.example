# Firebase (Firestore) — required for /store and /donate to persist orders/donations
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Payment destinations shown on /store and /donate
# Cash App: your $Cashtag *without* the leading $ (e.g. PBHS86)
VITE_CASHAPP_CASHTAG=YourCashTag
# Zelle: email address or phone number registered with your bank's Zelle
VITE_ZELLE_CONTACT=zelle@youremail.com
