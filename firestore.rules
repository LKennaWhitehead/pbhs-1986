rules_version = '2';

// PBHS '86 Reunion — Cash App / Zelle order + donation rules.
// Both collections default to status: "pending" on creation. An admin
// manually flips the flag to "verified" in the Firebase console after
// confirming the payment landed. The public progress bar on /donate
// only counts verified fundraiser donations.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Orders (T-shirt purchases) ────────────────────────────────────────
    // Write-only from the public client. No public reads.
    match /orders/{orderId} {
      allow read: if false;
      allow create: if isValidOrder(request.resource.data);
      allow update, delete: if false;
    }

    // ── Donations ─────────────────────────────────────────────────────────
    // Anyone can create a pending donation. Public reads are allowed ONLY
    // when the query filters status == "verified", so pending donations
    // (which may include unverified/false submissions) stay private.
    // The `list` rule enforces the required filter at the query level.
    match /donations/{donationId} {
      allow get: if false;
      allow list: if request.query.limit <= 1000
                  && verifiedFilterPresent();
      allow create: if isValidDonation(request.resource.data);
      allow update, delete: if false;
    }

    // Everything else: locked down by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// The rules language exposes query constraints via `resource.data` filters
// in the `where` map. We require the caller to have applied
// `where('status', '==', 'verified')` on any list read.
function verifiedFilterPresent() {
  return 'status' in request.query.where
      && request.query.where.status == 'verified';
}

function isValidOrder(data) {
  return data.keys().hasAll(['name', 'email', 'phone', 'size', 'quantity', 'amount', 'paymentMethod', 'status', 'timestamp'])
      && data.name is string && data.name.size() > 0 && data.name.size() < 200
      && data.email is string && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
      && data.phone is string && data.phone.size() > 0 && data.phone.size() < 40
      && data.size in ['S', 'M', 'L', 'XL', 'XXL', '3XL']
      && data.quantity is int && data.quantity > 0 && data.quantity <= 20
      && data.amount is number && data.amount > 0
      && data.paymentMethod in ['cashapp', 'zelle']
      && data.status == 'pending'
      && (!('confirmationNote' in data) || (data.confirmationNote is string && data.confirmationNote.size() < 500));
}

function isValidDonation(data) {
  return data.keys().hasAll(['name', 'email', 'phone', 'amount', 'type', 'paymentMethod', 'status', 'timestamp'])
      && data.name is string && data.name.size() > 0 && data.name.size() < 200
      && data.email is string && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
      && data.phone is string && data.phone.size() > 0 && data.phone.size() < 40
      && data.amount is number && data.amount > 0
      && data.type in ['fundraiser', 'auction']
      && data.paymentMethod in ['cashapp', 'zelle']
      && data.status == 'pending'
      && (!('message' in data) || (data.message is string && data.message.size() < 2000))
      && (!('confirmationNote' in data) || (data.confirmationNote is string && data.confirmationNote.size() < 500));
}
